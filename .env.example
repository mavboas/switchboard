# Copie para .env (cp .env.example .env) — ou rode `make env`, que gera uma chave aleatória.

# Chave mestra que cifra as chaves de API e tokens gravados pelo console.
# Vazia = gerada aleatoriamente na primeira subida e guardada no volume "secrets" do compose.
# Se definir aqui, use um valor longo e aleatório (make env gera um) e não perca:
# sem ela os segredos gravados não abrem.
SWITCHBOARD_SECRET_KEY=

# Variáveis de ambiente que podem ser usadas como segredo (env:NOME) na configuração.
SWITCHBOARD_ALLOWED_ENV_SECRETS=*_API_KEY,MCP_*

# Banco (o compose sobe um PostgreSQL 16 com pgvector)
POSTGRES_USER=switchboard
POSTGRES_PASSWORD=switchboard
POSTGRES_DB=switchboard

# Senha do console (usuário: admin). Vazio = console aberto; defina fora do ambiente local.
SWITCHBOARD_CONSOLE_PASSWORD=
# Nomes de host aceitos pelo console (protege contra DNS rebinding). Inclua o seu domínio/IP ao expor.
SWITCHBOARD_CONSOLE_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Chaves aceitas pela API do router (separadas por vírgula). Vazio = API aberta, só para uso local:
# sem chaves, o router só atende os hosts de SWITCHBOARD_ALLOWED_HOSTS.
SWITCHBOARD_API_KEYS=
SWITCHBOARD_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],router
# Chave que o console usa para chamar o router no playground (uma das chaves acima).
SWITCHBOARD_ROUTER_API_KEY=

# Chaves de provedores de LLM. No console, preencha o campo da chave com env:OPENAI_API_KEY (etc.).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Cria o roteador de demonstração (modelo offline + agentes de exemplo + base) no primeiro start.
SWITCHBOARD_SEED_DEMO=true

# Portas publicadas no host. Por padrão só em 127.0.0.1; use 0.0.0.0 para expor na rede
# (e aí defina senha do console e chaves da API).
CONSOLE_BIND=127.0.0.1
CONSOLE_PORT=8000
ROUTER_BIND=127.0.0.1
ROUTER_PORT=8080
AGENTS_BIND=127.0.0.1
